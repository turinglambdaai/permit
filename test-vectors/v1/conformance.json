    },
    {
      "name": "duplicate-envelope-member",
      "credential": "duplicate-member-envelope.json",
      "expected": "duplicate-json-reject"
    },
    {
      "name": "maintenance-cutoff-inclusive",
      "credential": "entitlement.permit.json",
      "trust_store": "trust-store.json",
      "query": {
        "kind": "update",
        "product": "gptp-studio",
        "published_at": "2027-10-15T23:59:59Z",
        "at": "2030-01-01T00:00:00Z",
        "version": "2.0.0"
      },
      "expected": true
    },
    {
      "name": "maintenance-cutoff-after",
      "credential": "entitlement.permit.json",
      "trust_store": "trust-store.json",
      "query": {
        "kind": "update",
