    {
      "name": "trial-extension-applies",
      "credential": "trial.permit.json",
      "trial_extensions": [
        "trial-extension.permit.json"
      ],
      "trust_store": "trust-store.json",
      "query": {
        "kind": "usable",
        "at": "2026-11-05T00:00:00Z"
