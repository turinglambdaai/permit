        "published_at": "2027-10-16T00:00:00Z",
        "at": "2030-01-01T00:00:00Z",
        "version": "2.0.0"
      },
      "expected": false
    },
    {
      "name": "version-bound",
      "credential": "entitlement.permit.json",
      "trust_store": "trust-store.json",
      "query": {
        "kind": "version",
        "version": "4.0.0"
      },
      "expected": false
    },
